# Cargo build output for the desktop workspace (its own target dir, distinct from the repo root's).
/target/

# The dmg installer output (make dmg / desktop/scripts/make-dmg.sh writes desktop/build/bin/). Build
# artifact — the tracked assets under desktop/build (darwin/entitlements.plist) stay; only bin/ is ignored.
/build/bin/

# Tauri build-time generated code + ACL schemas (src-tauri/gen/, regenerated by tauri-build).
/src-tauri/gen/

# TypeScript incremental build info (emitted by `tsc` via the composite project reference).
/frontend/*.tsbuildinfo

# The frontend bundle is BUILD OUTPUT — `npm run build` (and, in CI, the `desktop` job) regenerates
# it from ../frontend/src into frontend/dist, the rust source Tauri embeds via tauri.conf.json's
# `frontendDist`. The repo-root .gitignore already ignores every `dist/`, so re-include the dir here
# and keep only a .gitkeep anchor, so `tauri::generate_context!` resolves the path on a clean
# checkout. Mirrors $REF/desktop/frontend/dist's .gitkeep convention.
!/frontend/dist/
/frontend/dist/*
!/frontend/dist/.gitkeep
